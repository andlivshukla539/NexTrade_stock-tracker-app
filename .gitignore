# ════════════════════════════════════════════════════════
# NexTrade — .gitignore
# ════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────────────
.next/
out/

# ── Production Build ──────────────────────────────────
build/
dist/

# ── Environment Variables ─────────────────────────────
.env
.env.*
!.env.example

# ── IDE / Editor ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS Files ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ── Debug & Log Files ─────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Build / Lint / Debug Artifacts ────────────────────
build*.log
build*.txt
build-out*.txt
lint*.txt
lint*.json
lint-out*.txt
lint_*.txt
type_check*.txt
*.tsbuildinfo

# ── TypeScript ────────────────────────────────────────
next-env.d.ts
tsconfig.tsbuildinfo

# ── Testing ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma ────────────────────────────────────────────
prisma/migrations/

# ── Vercel ────────────────────────────────────────────
.vercel

# ── Misc ──────────────────────────────────────────────
*.pem
*.key
*.cert
.turbo
.cache

# ── Gemini / Agents ───────────────────────────────────
.agents/
